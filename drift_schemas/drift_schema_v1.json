  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"icon\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "recurring_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_rules\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category_id\" INTEGER NOT NULL REFERENCES categories (id), \"amount_cents\" INTEGER NOT NULL, \"note\" TEXT NOT NULL DEFAULT '', \"interval\" TEXT NOT NULL, \"day_of_month\" INTEGER NULL, \"start_day\" TEXT NOT NULL, \"next_index\" INTEGER NOT NULL DEFAULT 0, \"last_run_day\" TEXT NULL, \"not_before_day\" TEXT NULL, \"generated_count\" INTEGER NOT NULL DEFAULT 0, \"max_count\" INTEGER NULL, \"end_day\" TEXT NULL, \"paused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"paused\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "bookings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category_id\" INTEGER NOT NULL REFERENCES categories (id), \"amount_cents\" INTEGER NOT NULL, \"day\" TEXT NOT NULL, \"note\" TEXT NOT NULL DEFAULT '', \"recurring_id\" INTEGER NULL REFERENCES recurring_rules (id) ON DELETE SET NULL, \"is_auto\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_auto\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    }
